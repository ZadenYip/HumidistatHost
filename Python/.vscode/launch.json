    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: ble",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/ble.py",
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: modbus_master",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/modbus_master.py",
            "console": "integratedTerminal"
        }
    ]
}